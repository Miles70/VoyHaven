{
  "name": "voyhaven-travel",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo.mjs",
    "lint": "eslint .",
    "preview": "node scripts/preview.mjs",
    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "server:test": "npm --prefix server test",
    "check": "npm run lint && npm run build && npm run test:flight-results && npm run server:test && npm run test:languages && npm run test:localized-flows",
    "security:check": "node scripts/audit-high.mjs",
    "check:readiness": "npm --prefix server run check:readiness",
    "test:flight-android-ui": "node scripts/test-flight-android-ui.mjs",
    "test:flight-results": "node --test scripts/test-flight-results.test.mjs",
    "test:about-ui": "node scripts/test-about-ui.mjs",
    "test:nearby-scroll": "node scripts/test-nearby-scroll.mjs",
    "test:hotel-ui": "node scripts/test-hotel-ui.mjs",
    "test:hotel-e2e": "node scripts/test-hotel-e2e.mjs",
    "test:analytics-e2e": "node scripts/test-analytics-e2e.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test:seo-e2e": "node scripts/test-seo-e2e.mjs",
    "seo:refresh": "node scripts/refresh-seo-hotels.mjs",
    "test:legal-ui": "node scripts/test-legal-ui.mjs",
    "test:languages": "node scripts/test-languages.mjs",
    "test:localized-flows": "node scripts/test-localized-flows.mjs",
    "postinstall": "node scripts/patch-wallet-zod.mjs",
    "test:wallet-security": "node --test scripts/test-wallet-security.test.mjs",
    "test:wallet-e2e": "node scripts/test-wallet-e2e.mjs"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-wagmi": "^1.8.23",
    "@tanstack/react-query": "^5.102.8",
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "axios": "^1.20.0",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "uuid": "^11.1.1",
    "ws": "^8.20.2",
    "@walletconnect/ethereum-provider": "2.26.0",
    "@reown/appkit-wallet": {
      "zod": "4.6.7"
    },
    "@coinbase/cdp-sdk": {
      ".": "1.55.0",
      "zod": "4.6.7",
      "abitype": "1.3.0"
    }
  }
